{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/xxapi/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/admin",
      "destination": "/api/index.ts"
    },
    {
      "source": "/vivipayhub",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!static|assets|public|favicon.ico|robots.txt|rsCfg.json).*)",
      "destination": "/api/index.ts"
    }
  ]
}
