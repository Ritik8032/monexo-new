{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.10.0",
      "env": {
        "JAVA_VERSION": "17"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "20.10.0",
      "env": {
        "JAVA_VERSION": "17"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "internal",
      "node": "20.10.0",
      "env": {
        "JAVA_VERSION": "17"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
